# Deployer private key (keep secure, never commit)
DEPLOYER_PRIVATE_KEY=0x...

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# DisputeGameFactory address (used after initial deployment)
HOODI_GAME_FACTORY_ADDRESS=

# Note: Network-specific parameters (RPC URLs, addresses, etc.) are now in networks.toml