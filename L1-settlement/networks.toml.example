# Network Configurations for Compose Contracts Deployment
# Copy this file to networks.toml and configure for your networks

# =============================================================================
# Hoodi L1 Network
# =============================================================================
[networks.hoodi]
name = "Hoodi L1"
rpc_url = "https://your-hoodi-rpc-url"
chain_id = 12345  # Replace with actual chain ID
explorer_url = "https://hoodi.etherscan.io"  # Replace with actual explorer
explorer_api_url = "https://api-hoodi.etherscan.io/api"

# ComposeL2OutputOracle initialization parameters
verifier_address = "0x17Ef331C3c90E9e5718e81085c721a404eF18436"
owner_address = "0xA139A1776E60F9645533a9AD419461818D6839a1"
proposer_address = "0xb054981b2Ef67603E50B1bD840D0834ef5bcceE4"
aggregation_vkey = "0x0059ae2f8c8ad61a6af02594067148b58dbecff2e3352170923efda8ea603f1e"
starting_superblock_number = 0

# DisputeGameFactory initialization parameters
admin_address = "0xA139A1776E60F9645533a9AD419461818D6839a1"

# =============================================================================
# Ethereum Sepolia Testnet
# =============================================================================
[networks.sepolia]
name = "Ethereum Sepolia"
rpc_url = "https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
chain_id = 11155111
explorer_url = "https://sepolia.etherscan.io"
explorer_api_url = "https://api-sepolia.etherscan.io/api"

# ComposeL2OutputOracle initialization parameters
verifier_address = "0x17Ef331C3c90E9e5718e81085c721a404eF18436"
owner_address = "0xYourOwnerAddress"
proposer_address = "0xYourProposerAddress"
aggregation_vkey = "0x0059ae2f8c8ad61a6af02594067148b58dbecff2e3352170923efda8ea603f1e"
starting_superblock_number = 0

# DisputeGameFactory initialization parameters
admin_address = "0xYourAdminAddress"

# =============================================================================
# Ethereum Mainnet
# =============================================================================
[networks.mainnet]
name = "Ethereum Mainnet"
rpc_url = "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
chain_id = 1
explorer_url = "https://etherscan.io"
explorer_api_url = "https://api.etherscan.io/api"

# ComposeL2OutputOracle initialization parameters
verifier_address = "0xYourVerifierAddress"
owner_address = "0xYourOwnerAddress"
proposer_address = "0xYourProposerAddress"
aggregation_vkey = "0xYourAggregationVkey"
starting_superblock_number = 0

# DisputeGameFactory initialization parameters
admin_address = "0xYourAdminAddress"

# =============================================================================
# Configuration Field Descriptions
# =============================================================================
# 
# Network Configuration:
# - name: Human-readable network name
# - rpc_url: RPC endpoint URL for the network
# - chain_id: Network chain ID
# - explorer_url: Block explorer homepage URL
# - explorer_api_url: Block explorer API endpoint for verification
#
# ComposeL2OutputOracle Parameters:
# - verifier_address: Address of the deployed SP1Verifier contract
# - owner_address: Owner address with admin permissions
# - proposer_address: Approved proposer address for L2 outputs
# - aggregation_vkey: Verification key for the SP1 aggregation program
# - starting_superblock_number: Starting superblock number (usually 0)
#
# DisputeGameFactory Parameters:
# - admin_address: Admin address that controls the factory
