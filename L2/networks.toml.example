# ============================================================================
# Network Configurations for L2 Rollup Deployments
# ============================================================================
# 
# Usage:
#   1. Copy this file: cp networks.toml.example networks.toml
#   2. Fill in your network details
#   3. Deploy: just deploy-core <network-name>
#
# Note: networks.toml is gitignored to prevent accidental credential leaks
# ============================================================================

[rollup-a]
name = "Rollup A"
chain_id = 77777
rpc_url = "http://57.129.73.156:31130/"
# Blockscout explorer configuration
explorer_type = "blockscout"
explorer_url = "https://rollup-a-bck.explorer.testnet.compose.network/api/eth-rpc"
explorer_api_url = "https://rollup-a-bck.explorer.testnet.compose.network/api/"

[rollup-b]
name = "Rollup B"
chain_id = 88888
rpc_url = "http://57.129.73.144:31133"
# Blockscout explorer configuration
explorer_type = "blockscout"
explorer_url = "https://rollup-b-bck.explorer.testnet.compose.network/api/eth-rpc"
explorer_api_url = "https://rollup-b-bck.explorer.testnet.compose.network/api/"

# Add more networks as needed following the same pattern:
# [network-name]
# name = "Display Name"
# chain_id = 12345
# rpc_url = "https://..."
# explorer_type = "blockscout"
# explorer_url = "https://..."
# explorer_api_url = "https://..."
