# ============================================================================
# DEX Contract Verification
# ============================================================================

# Verify all DEX contracts on network
verify-all-dex NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    
    echo "========================================="
    echo "Verifying DEX contracts on {{NETWORK}}"
    echo "========================================="
    
    # Get contract addresses from deployments.json
    WETH=$(jq -r '.["{{NETWORK}}"].dex.WETH // empty' deployments.json 2>/dev/null)
    USDC=$(jq -r '.["{{NETWORK}}"].dex.USDC // empty' deployments.json 2>/dev/null)
    SSV=$(jq -r '.["{{NETWORK}}"].dex.SSV // empty' deployments.json 2>/dev/null)
    SWAPPER=$(jq -r '.["{{NETWORK}}"].dex.Swapper // empty' deployments.json 2>/dev/null)
    
    if [ -z "$WETH" ]; then
        echo "Error: No DEX deployment found for {{NETWORK}}"
        echo "Run 'just deploy-dex-tokens {{NETWORK}}' first"
        exit 1
    fi
    
    # Verify WETH
    echo ""
    echo "Verifying WETH at $WETH..."
    just verify-weth {{NETWORK}} "$WETH" || true
    
    # Verify USDC
    echo ""
    echo "Verifying USDC at $USDC..."
    just verify-usdc {{NETWORK}} "$USDC" || true
    
    # Verify SSV
    echo ""
    echo "Verifying SSV at $SSV..."
    just verify-ssv {{NETWORK}} "$SSV" || true
    
    # Verify Swapper (if deployed)
    if [ -n "$SWAPPER" ] && [ "$SWAPPER" != "null" ]; then
        echo ""
        echo "Verifying Swapper at $SWAPPER..."
        just verify-swapper {{NETWORK}} "$SWAPPER" "$WETH" "$USDC" "$SSV" || true
    else
        echo ""
        echo "⚠ Swapper not deployed, skipping verification"
    fi
    
    echo ""
    echo "========================================="
    echo "✓ DEX verification complete!"
    echo "========================================="

