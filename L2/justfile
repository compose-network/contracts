# Get Mailbox address for network
get-mailbox NETWORK:
    @jq -r '.["{{NETWORK}}"].contracts.Mailbox // "Not deployed"' deployments.json 2>/dev/null || echo "deployments.json not found"

# Get PingPong address for network
get-pingpong NETWORK:
    @jq -r '.["{{NETWORK}}"].contracts.PingPong // "Not deployed"' deployments.json 2>/dev/null || echo "deployments.json not found"

# Get Bridge address for network
get-bridge NETWORK:
    @jq -r '.["{{NETWORK}}"].contracts.Bridge // "Not deployed"' deployments.json 2>/dev/null || echo "deployments.json not found"

# Get Token address for network
get-token NETWORK:
    @jq -r '.["{{NETWORK}}"].contracts.BridgeableToken // "Not deployed"' deployments.json 2>/dev/null || echo "deployments.json not found"

# ============================================================================
# Utilities
# ============================================================================

# Format Solidity code
format:
    @echo "Formatting Solidity code..."
    forge fmt
    @echo "✓ Formatting complete!"

# Check Solidity code formatting
format-check:
    @echo "Checking Solidity formatting..."
    forge fmt --check

# Generate gas report
gas-report:
    @echo "Generating gas report..."
    forge test --gas-report

# View deployment logs for a network
logs NETWORK:
    @if [ -f deployment-{{NETWORK}}.log ]; then \
        cat deployment-{{NETWORK}}.log; \
    else \
        echo "No logs found for network: {{NETWORK}}"; \
    fi

# Create networks.toml from example if it doesn't exist
init-config:
    @if [ ! -f networks.toml ]; then \
        cp networks.toml.example networks.toml; \
        echo "✓ Created networks.toml from example"; \
        echo "  Please edit networks.toml with your network configurations"; \
    else \
        echo "networks.toml already exists"; \
    fi
    @if [ ! -f .env ]; then \
        cp .env.example .env; \
        echo "✓ Created .env from example"; \
        echo "  Please edit .env with your private key and configuration"; \
    else \
        echo ".env already exists"; \
    fi

# Validate setup
check-setup:
    @echo "Checking L2 deployment setup..."
    @echo ""
    @echo "=== Configuration Files ==="
    @if [ -f .env ]; then \
        echo "✓ .env file exists"; \
        if grep -q "DEPLOYER_PRIVATE_KEY=0x\.\.\." .env; then \
            echo "  ⚠ DEPLOYER_PRIVATE_KEY needs to be set"; \
        else \
            echo "  ✓ DEPLOYER_PRIVATE_KEY is set"; \
        fi; \
        if grep -q "COORDINATOR_ADDRESS=0x\.\.\." .env; then \
            echo "  ⚠ COORDINATOR_ADDRESS needs to be set"; \
        else \
            echo "  ✓ COORDINATOR_ADDRESS is set"; \
        fi; \
    else \
        echo "✗ .env file missing. Run: just init-config"; \
    fi
    @if [ -f networks.toml ]; then \
        echo "✓ networks.toml file exists"; \
        echo "  Configured networks: $$(grep '^\[' networks.toml | wc -l | tr -d ' ')"; \
    else \
        echo "✗ networks.toml missing. Run: just init-config"; \
    fi
    @echo ""
    @echo "=== Build Status ==="
    @if [ -d out ]; then \
        echo "✓ Contracts built (out/ directory exists)"; \
    else \
        echo "⚠ Contracts not built yet. Run: just build"; \
    fi

# ============================================================================
# DEX Deployment
# ============================================================================

# Deploy DEX tokens (WETH, USDC, SSV) to network
deploy-dex-tokens NETWORK:
    @./scripts/dex/deploy-tokens.sh {{NETWORK}}

# Deploy swapper contract to network (requires tokens deployed first)
deploy-dex-swapper NETWORK:
    @./scripts/dex/deploy-swapper.sh {{NETWORK}}

# Fund swapper with liquidity (default amounts: 1M each)
fund-dex-swapper NETWORK:
    @./scripts/dex/fund-swapper.sh {{NETWORK}}

# Fund swapper with custom amounts (in ether units, e.g., 1000000 = 1M tokens)
fund-dex-swapper-custom NETWORK WETH_AMOUNT USDC_AMOUNT SSV_AMOUNT:
    @./scripts/dex/fund-swapper.sh {{NETWORK}} {{WETH_AMOUNT}} {{USDC_AMOUNT}} {{SSV_AMOUNT}}

# Deploy all DEX contracts to network and fund swapper
deploy-dex-all NETWORK:
    @echo "========================================="
    @echo "Deploying complete DEX stack to {{NETWORK}}"
    @echo "========================================="
    @just deploy-dex-tokens {{NETWORK}}
    @echo ""
    @echo "✓ Tokens deployed"
    @echo ""
    @just deploy-dex-swapper {{NETWORK}}
    @echo ""
    @echo "✓ Swapper deployed"
    @echo ""
    @just fund-dex-swapper {{NETWORK}}
    @echo ""
    @echo "========================================="
    @echo "✓ Complete DEX stack deployed!"
    @echo "========================================="

# Get DEX deployment info for network
get-dex-info NETWORK:
    @echo "DEX Deployment Info for {{NETWORK}}:"
    @echo ""
    @if [ -f deployments.json ]; then \
        jq -r '.["{{NETWORK}}"].dex // "DEX not deployed on this network"' deployments.json; \
    else \
        echo "deployments.json not found"; \
    fi

# Get swapper reserves for network
get-dex-reserves NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    if [ -f deployments.json ]; then
        SWAPPER=$(jq -r '.["{{NETWORK}}"].dex.Swapper // empty' deployments.json)
        if [ -n "$SWAPPER" ] && [ "$SWAPPER" != "null" ]; then
            echo "Swapper Reserves on {{NETWORK}}:"
            cast call $SWAPPER "getReserves()(uint256,uint256,uint256)" --rpc-url "$NETWORK_RPC_URL"
        else
            echo "Swapper not deployed on {{NETWORK}}"
        fi
    else
        echo "deployments.json not found"
    fi

# Check swap price on network (example: WETH to USDC, 1 token)
check-swap-price NETWORK TOKEN_IN TOKEN_OUT AMOUNT:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    if [ -f deployments.json ]; then
        SWAPPER=$(jq -r '.["{{NETWORK}}"].dex.Swapper // empty' deployments.json)
        if [ -n "$SWAPPER" ] && [ "$SWAPPER" != "null" ]; then
            echo "Swap Price on {{NETWORK}}:"
            echo "  From: Token {{TOKEN_IN}}"
            echo "  To:   Token {{TOKEN_OUT}}"
            echo "  Amount: {{AMOUNT}}"
            cast call $SWAPPER "getSwapPrice(uint8,uint8,uint256)(uint256,uint256)" {{TOKEN_IN}} {{TOKEN_OUT}} {{AMOUNT}} --rpc-url "$NETWORK_RPC_URL"
        else
            echo "Swapper not deployed on {{NETWORK}}"
        fi
    else
        echo "deployments.json not found"
    fi
